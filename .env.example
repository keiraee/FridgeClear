# Alibaba Cloud RDS / local database connection
DB_HOST=rm-2vc0m0i62377rv312jo.mysql.cn-chengdu.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=fridge_clear
DB_USERNAME=fridge_clear
DB_PASSWORD=replace_with_your_password
DB_USE_SSL=true

# Only required when starting the local MySQL Docker container.
MYSQL_ROOT_PASSWORD=replace_with_root_password

# AES-256 Base64 key for encrypting AI provider API keys. Generate with:
# openssl rand -base64 32
AI_PROVIDER_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# JWT signing key. Generate with:
# openssl rand -base64 32
AUTH_JWT_SECRET=replace_with_base64_32_byte_key
AUTH_JWT_EXPIRATION_SECONDS=7200
