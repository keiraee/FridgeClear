# Copy to deploy.env and fill in (deploy.env is gitignored).

DEPLOY_SERVER=root@8.137.126.178
DEPLOY_REMOTE_DIR=/opt/fridgeclear

# --- Recommended: SSH key (stable, no password in file) ---
#   ssh-keygen -t ed25519 -f ~/.ssh/fridgeclear_deploy -N ""
#   ssh-copy-id -i ~/.ssh/fridgeclear_deploy.pub root@8.137.126.178
# DEPLOY_SSH_IDENTITY_FILE=~/.ssh/fridgeclear_deploy
# DEPLOY_SSH_PASSWORD=

# --- Alternative: password + sshpass (works but less reliable) ---
#   brew install hudochenkov/sshpass/sshpass
# Use single quotes if password contains $ ! # etc.
# DEPLOY_SSH_PASSWORD='your-password'

# Optional retries (defaults: 3 attempts, 3s apart)
# DEPLOY_MAX_RETRIES=3
# DEPLOY_RETRY_DELAY_SEC=3
